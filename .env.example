# Which model reads your document. Any Anthropic or OpenAI-compatible endpoint
# works — hosted or running on your own machine. Everything here is optional
# and can also be set in the app, on the first screen.

# Preset: anthropic | openai | google | openrouter | groq | together |
#         deepseek | mistral | ollama | lmstudio | vllm | custom
SPEC_ENGINE_PROVIDER=anthropic

# Overrides the preset's defaults.
# SPEC_ENGINE_MODEL=claude-opus-5
# SPEC_ENGINE_BASE_URL=http://localhost:11434/v1
# SPEC_ENGINE_MAX_TOKENS=16000

# Structured output: json_schema | json_object | prompt.
# Leave unset — the client starts at the preset's tier and steps down on its
# own if the server rejects it.
# SPEC_ENGINE_SCHEMA_MODE=json_schema

# The key for whichever provider you chose. Each preset reads its own
# conventional variable first, so you can keep several here at once —
# headless runs always read these; for the interactive app see
# SPEC_ENGINE_ALLOW_SERVER_KEY below.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...

# Anything with no conventional variable of its own falls back to this.
# SPEC_ENGINE_API_KEY=...

# Interactive sessions (streamlit run app.py) resolve keys from the
# environment only when this is set — on a shared or public host the app
# must not spend the operator's money on an anonymous visitor's compiles.
# Values: 1 | true | yes | on. Leave unset on any host other people can
# reach; headless and scripted runs always read the keys above.
# SPEC_ENGINE_ALLOW_SERVER_KEY=1

# A model running on localhost is reported as free. A model that is neither
# local nor in the app's rate table gets token counts and no dollar figure —
# set these (USD per million tokens) to price it yourself.
# SPEC_ENGINE_INPUT_RATE=0.60
# SPEC_ENGINE_OUTPUT_RATE=0.90

# Where the current run is saved. Off by default: on a shared or public host
# one process serves every visitor, and a shared file would hand one
# stranger's document to the next. Opt in on a machine where one person owns
# the data — with a directory path, or "on" for the default .spec_engine
# directory.
# SPEC_ENGINE_STORE=on
# SPEC_ENGINE_STORE=.spec_engine
